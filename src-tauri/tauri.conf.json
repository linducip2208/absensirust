{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AttendX Rust",
  "version": "1.0.0",
  "identifier": "id.co.attendx.rust",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "AttendX Rust", "width": 1366, "height": 768, "minWidth": 1024, "minHeight": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Business",
    "shortDescription": "Aplikasi absensi karyawan AttendX",
    "longDescription": "AttendX Rust - aplikasi absensi karyawan profesional dengan dukungan multi-hardware, offline, zona waktu Asia/Jakarta."
  }
}
